#!/bin/bash
#
# tmux-main: attach to the "main" tmux session, building it first if it does not exist.
#
#   tmux-main          attach (from inside tmux: switch to it). Run by the `t` alias.
#   tmux-main --auto   attach only when no other client shows main. Run by .zshrc when
#                      iTerm2 opens a shell, so a second iTerm2 tab stays a plain zsh.
#   tmux-main <args>   any other arguments go to tmux as they are (`t ls`, `t new -s x`).
#
# A main session that already exists is attached as it is, even if windows or panes were
# closed by hand: rebuilding would kill windows that may still run Claude Code.
# To start over, close main (`tk main`) and run `t`.
#
# The windows of a new main session come from ~/.tmux-main.local (dot.tmux-main.local,
# not tracked: the directories are machine specific). It is a bash file with one line per
# window, `window <name> <dir>...`, and 1, 2 or 4 directories per window (splits are even):
#
#   window web  ~/src/web ~/src/web     # 2 dirs: left | right
#   window api  ~/src/api ~/src/worker \
#               ~/src/db  ~/src/infra   # 4 dirs: top left, top right, bottom left, bottom right
#
# Without that file, main is one window in $HOME. See dot.tmux-main.local.example.

set -eu

session=main
layout=${TMUX_MAIN_LAYOUT:-$HOME/.tmux-main.local}

command -v tmux >/dev/null 2>&1 || { echo 'tmux-main: tmux not found' >&2; exit 1; }

auto=false
if [[ ${1:-} == --auto ]]; then
  auto=true
elif (( $# > 0 )); then
  exec tmux "$@"
fi

if $auto; then
  # list-clients prints one line per client attached to main; empty means nobody shows it.
  if tmux has-session -t "=$session" 2>/dev/null &&
     [[ -n $(tmux list-clients -t "=$session" 2>/dev/null) ]]; then
    exit 0
  fi
fi

names=()
dirs_of=()  # the directories of names[i], joined with \x1f
window() {
  if (( $# != 2 && $# != 3 && $# != 5 )); then
    echo "tmux-main: window ${1:-}: give 1, 2 or 4 directories" >&2
    return 1
  fi
  names+=("$1")
  shift
  local IFS=$'\x1f'
  dirs_of+=("$*")
}

if ! tmux has-session -t "=$session" 2>/dev/null; then
  if [[ -r $layout ]]; then
    # shellcheck source=/dev/null
    source "$layout"
  fi
  if (( ${#names[@]} == 0 )); then
    window "${SHELL##*/}" "$HOME"
  fi

  # A detached session starts at 80x24 and the splits are made at that size. Give it the
  # size of the terminal that is about to attach, so the halves stay even after attaching.
  size=()
  if read -r rows cols < <(stty size 2>/dev/null) && [[ -n ${cols:-} ]]; then
    size=(-x "$cols" -y "$rows")
  fi

  # The session is built under a temporary name and renamed to main only when it is
  # complete. iTerm2 restores several windows at once, so two shells can get here
  # together: the one that renames second fails, drops its copy and uses the first one's
  # main. A build that fails halfway is killed by the trap instead of being left as main.
  build=main-build-$$
  trap 'tmux kill-session -t "=$build" 2>/dev/null || true' EXIT

  # Panes are addressed by the ids tmux prints (-P -F), not by index, so base-index and
  # pane-base-index do not matter. A window created with -n keeps its name: tmux turns
  # automatic-rename off for it.
  first=
  for i in "${!names[@]}"; do
    IFS=$'\x1f' read -r -a dirs <<<"${dirs_of[$i]}"

    # A directory that no longer exists would make tmux fall back to the start directory
    # silently, so the pane would open in the wrong place without telling anyone.
    for d in "${dirs[@]}"; do
      [[ -d $d ]] || echo "tmux-main: $d does not exist; the pane opens in \$HOME" >&2
    done

    if [[ -z $first ]]; then
      pane=$(tmux new-session -d -s "$build" ${size[@]+"${size[@]}"} \
               -n "${names[$i]}" -c "${dirs[0]}" -P -F '#{pane_id}')
      first=$pane
    else
      pane=$(tmux new-window -d -t "=$build:" -n "${names[$i]}" -c "${dirs[0]}" -P -F '#{pane_id}')
    fi

    case ${#dirs[@]} in
      2)
        tmux split-window -h -t "$pane" -c "${dirs[1]}"
        ;;
      4)
        right=$(tmux split-window -h -t "$pane" -c "${dirs[1]}" -P -F '#{pane_id}')
        tmux split-window -v -t "$pane" -c "${dirs[2]}"
        tmux split-window -v -t "$right" -c "${dirs[3]}"
        ;;
    esac
  done

  tmux select-window -t "$first"
  tmux select-pane -t "$first"

  if tmux rename-session -t "=$build" "$session" 2>/dev/null; then
    trap - EXIT
  else
    # Another shell built main first, so this copy is dropped here (the exec below would
    # skip the trap). With --auto that shell is the one attaching; this one stays a zsh.
    tmux kill-session -t "=$build" 2>/dev/null || true
    trap - EXIT
    $auto && exit 0
  fi
fi

if [[ -n ${TMUX:-} ]]; then
  exec tmux switch-client -t "=$session"
fi
exec tmux attach-session -t "=$session"
