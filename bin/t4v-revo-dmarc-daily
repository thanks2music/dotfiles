#!/bin/bash
#
# t4v-revo-dmarc-daily — Revolution のサイトのドメインの DMARC レポートを毎日チェックする入口。
#                        本体は one-more-time の scripts/dmarc/dmarc-daily.ts。
#
#   使い方:
#     t4v-revo-dmarc-daily             # launchd が毎朝 9:00 に実行する (引数なし = 本番)
#     t4v-revo-dmarc-daily --dry-run   # 引数を付けるとテスト: 送り先をすべて開発系にし [TEST] を付け、state を更新しない
#     (引数は dmarc-daily.ts にそのまま渡す。例: --fixture <xml> / --no-claude)
#
#     T4V_REVO_DMARC_APP=<scripts/dmarc のパス> t4v-revo-dmarc-daily
#       マージ前の動作確認用。worktree を使わず、指定した場所のコードを動かす (必ずテストになる)
#
#   登録: setup.sh の phase_launchd が launchd/com.thanks2music.t4v-revo-dmarc.plist を読み込む。
#         すぐ実行したい時: launchctl kickstart gui/$(id -u)/com.thanks2music.t4v-revo-dmarc
#   ログ: ~/Library/Logs/t4v-revo-dmarc/YYYY-MM-DD.log (30 日で削除)
#
# 設計:
#   - 本番になるのは「引数なし、かつ T4V_REVO_DMARC_APP なし」の時だけ (launchd / kickstart)。それ以外はすべて
#     T4V_REVO_DMARC_TEST=1 を渡してテストにする。手で試す時に、本番系への通知や state の更新が起きないように
#   - one-more-time の作業ツリーは feature ブランチになっていることが多いので、自動実行専用の worktree
#     ($WORKTREE) を origin/main に置いて動かす。main は作業ツリー側で checkout されていることがあるため、
#     ブランチではなく detached HEAD にする
#   - トークンはキーチェーンから読み、env で渡す。値はログに出さない
#       t4v-revo-dmarc.slack-bot-token    Slack の bot token (revolution の通知と同じもの)
#       t4v-revo-dmarc.claude-oauth-token 個人アカウントの `claude setup-token` (1 年で切れる)
#   - Slack の送り先は ~/.config/t4v-revo-dmarc/slack.env に置く (公開リポジトリに Slack の構成を載せないため)。
#     中身と作り方は one-more-time の scripts/dmarc/README.md
#   - git fetch に失敗しても (スリープから復帰した直後でネットワークがまだ無い等)、少し待ってやり直し、
#     それでも駄目なら手元の worktree のまま動かす。チェックそのものを飛ばさないため
#   - git fetch と npm ci は gtimeout で打ち切る。止まったままだと、launchd が次の日の実行を始めないため
#   - 同時に 2 つ動かない (手で試すのと 9:00 が重なると state を取り合う)
#   - dmarc-daily.ts の終了コード: 0 = 正常 / 2 = 失敗したが自分で知らせた / 1 = 知らせられなかった。
#     1 の時と、node を起動する前に失敗した時は、この入口が知らせる。Slack にも届かなければ macOS の通知を出す
set -u
set -o pipefail

REPO="$HOME/work/dev/my-projects/one-more-time"
WORKTREE="$HOME/.local/share/t4v-revo-dmarc/one-more-time"
APP="${T4V_REVO_DMARC_APP:-$WORKTREE/scripts/dmarc}"
LOG_DIR="$HOME/Library/Logs/t4v-revo-dmarc"
SLACK_ENV="$HOME/.config/t4v-revo-dmarc/slack.env"
LOCK_DIR="${TMPDIR:-/tmp}/t4v-revo-dmarc.lock"

# launchd の PATH は最小限なので、node (asdf)・claude・git と gtimeout (Homebrew) を足す
export PATH="$HOME/.asdf/shims:$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

mkdir -p "$LOG_DIR"
exec >> "$LOG_DIR/$(date +%F).log" 2>&1
find "$LOG_DIR" -name '*.log' -mtime +30 -delete 2> /dev/null || true

log() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }

TEST=0
if [ "$#" -gt 0 ] || [ -n "${T4V_REVO_DMARC_APP:-}" ]; then TEST=1; fi
export T4V_REVO_DMARC_TEST="$TEST"

SLACK_CHANNEL_PROD="" SLACK_CHANNEL_DEV="" SLACK_MENTION_USER_ID="" SLACK_BOT_TOKEN=""

# macOS の通知。値は引数で渡す (AppleScript の文字列に埋め込むと、" や \ で壊れるため。brew-update-check と同じ形)
mac_notify() {
	osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "DMARC の自動チェック"' -e 'end run' \
		"$1" 2> /dev/null || true
}

# 失敗を Slack に知らせる。テストでは開発系に [TEST] で送る。Slack に届かなければ macOS の通知を出す
notify_failure() {
	local stage="$1" detail="$2" channel="$SLACK_CHANNEL_PROD" head="<@$SLACK_MENTION_USER_ID> " text ok error
	if [ "$TEST" = 1 ]; then
		channel="$SLACK_CHANNEL_DEV"
		head="[TEST] "
	fi
	text="${head}❌ DMARC の自動チェックが失敗しました (${stage})
${detail}
ログ: $LOG_DIR/$(date +%F).log"
	log "失敗: $stage"
	if [ -n "$SLACK_BOT_TOKEN" ] && [ -n "$channel" ]; then
		# text は固定文・段階名・パスだけなので、Slack のエスケープ (& < >) は要らない。jq は JSON にするためだけに使う
		error="$(jq -n --arg c "$channel" --arg t "$text" '{channel:$c, text:$t, unfurl_links:false}' |
			curl -sS --max-time 10 -X POST https://slack.com/api/chat.postMessage \
				-H "Authorization: Bearer $SLACK_BOT_TOKEN" -H 'Content-Type: application/json; charset=utf-8' --data @- |
			jq -r 'if .ok then "" else (.error // "unknown") end' 2> /dev/null)" && ok=1 || ok=0
		if [ "$ok" = 1 ] && [ -z "$error" ]; then return 0; fi
		log "Slack への送信にも失敗した (${error:-network})"
	fi
	mac_notify "${stage} で失敗。ログ: $LOG_DIR"
}

keychain() { security find-generic-password -a "$USER" -s "$1" -w 2> /dev/null; }

log "開始 (args: $* / test=$TEST)"

if ! mkdir "$LOCK_DIR" 2> /dev/null; then
	log "別の実行が動いているので終わる ($LOCK_DIR)"
	exit 0
fi
trap 'rmdir "$LOCK_DIR" 2> /dev/null' EXIT

# Slack の送り先を読む (KEY=VALUE の 3 行だけを受け付ける。source しない)
if [ -f "$SLACK_ENV" ]; then
	while IFS='=' read -r key value; do
		case "$key" in
			SLACK_CHANNEL_PROD | SLACK_CHANNEL_DEV | SLACK_MENTION_USER_ID) printf -v "$key" '%s' "$value" ;;
		esac
	done < "$SLACK_ENV"
fi
export SLACK_CHANNEL_PROD SLACK_CHANNEL_DEV SLACK_MENTION_USER_ID
if [ -z "$SLACK_CHANNEL_PROD" ] || [ -z "$SLACK_CHANNEL_DEV" ] || [ -z "$SLACK_MENTION_USER_ID" ]; then
	notify_failure "slack.env" "$SLACK_ENV に SLACK_CHANNEL_PROD / SLACK_CHANNEL_DEV / SLACK_MENTION_USER_ID が無い"
	exit 1
fi

SLACK_BOT_TOKEN="$(keychain t4v-revo-dmarc.slack-bot-token)"
export SLACK_BOT_TOKEN
if [ -z "$SLACK_BOT_TOKEN" ]; then
	notify_failure "Slack の token" "キーチェーンに t4v-revo-dmarc.slack-bot-token が無い"
	exit 1
fi

# Claude の token は無くても集計と通知はできる (調査だけが「取れなかった」になる)
CLAUDE_CODE_OAUTH_TOKEN="$(keychain t4v-revo-dmarc.claude-oauth-token)"
export CLAUDE_CODE_OAUTH_TOKEN

update_worktree() {
	local i fetched=0
	for i in 1 2 3; do
		if gtimeout 60 git -C "$REPO" fetch --quiet origin main; then
			fetched=1
			break
		fi
		log "git fetch に失敗 ($i 回目)"
		if [ "$i" -lt 3 ]; then sleep 30; fi
	done
	if [ "$fetched" = 0 ]; then
		if [ -d "$WORKTREE" ]; then
			# 手元の worktree (前回の origin/main) のまま動かす。チェックそのものは飛ばさない
			log "git fetch に失敗したので、worktree を更新せずに動かす: $(git -C "$WORKTREE" rev-parse --short HEAD)"
			return 0
		fi
		notify_failure "git fetch" "one-more-time の origin/main を取得できず、worktree もまだ無い"
		return 1
	fi
	if [ ! -d "$WORKTREE" ]; then
		mkdir -p "$(dirname "$WORKTREE")"
		if ! git -C "$REPO" worktree add --quiet --detach "$WORKTREE" origin/main; then
			notify_failure "git worktree" "$WORKTREE を作れなかった"
			return 1
		fi
	fi
	if [ -n "$(git -C "$WORKTREE" status --porcelain --untracked-files=no)" ]; then
		notify_failure "git worktree" "$WORKTREE に未コミットの変更がある。自動実行専用なので、変更を消してから再実行する"
		return 1
	fi
	if ! git -C "$WORKTREE" checkout --quiet --detach origin/main; then
		notify_failure "git checkout" "$WORKTREE を origin/main にできなかった"
		return 1
	fi
	log "worktree: $(git -C "$WORKTREE" rev-parse --short HEAD)"
}

if [ -n "${T4V_REVO_DMARC_APP:-}" ]; then
	log "app: $APP (T4V_REVO_DMARC_APP)"
else
	update_worktree || exit 1
fi

# 依存は package-lock.json が変わった時か、node_modules が無い時だけ入れ直す。
# worktree では、型を取り除いてそのまま実行するので devDependencies (typescript など) を入れない。
# T4V_REVO_DMARC_APP で手元の作業ツリーを指した時は、型検査に要るので入れる
npm_omit=(--omit=dev)
if [ -n "${T4V_REVO_DMARC_APP:-}" ]; then npm_omit=(); fi
lock_sha="$(shasum -a 256 "$APP/package-lock.json" | cut -d' ' -f1)"
if [ "$(cat "$APP/node_modules/.lock-sha" 2> /dev/null)" != "$lock_sha" ]; then
	log "npm ci"
	if ! (cd "$APP" && gtimeout 600 npm ci ${npm_omit[@]+"${npm_omit[@]}"} --no-audit --no-fund --loglevel=error); then
		notify_failure "npm ci" "scripts/dmarc の依存を入れられなかった"
		exit 1
	fi
	echo "$lock_sha" > "$APP/node_modules/.lock-sha"
fi

cd "$APP" || exit 1
node dmarc-daily.ts "$@"
rc=$?
log "終了 (exit ${rc})"
case "$rc" in
	0 | 2) exit "$rc" ;; # 2 は dmarc-daily.ts が自分で失敗を知らせた
	*)
		notify_failure "dmarc-daily.ts" "exit ${rc}。失敗を Slack に届けられなかったか、想定外の失敗"
		exit "$rc"
		;;
esac
