<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  bin/brew-update-check を毎日 12:00 に実行する LaunchAgent のテンプレート。

  setup.sh の phase_launchd が __HOME__ を置き換えて ~/Library/LaunchAgents/ に生成し、
  launchctl bootstrap で読み込む。plist には絶対パスが必要なので、symlink ではなく生成する。
  ここを編集したら setup.sh を再実行する（bootout してから読み込み直す）。

  - StartCalendarInterval: スリープ中で時刻を過ぎた場合は、復帰したときに 1 回だけ実行される
    （cron と違って取りこぼさない。launchd.plist(5)）
  - ProcessType Background: 作業の邪魔をしないよう、CPU と I/O の優先度を下げる
  - 標準出力: スクリプトは自分で日付ごとのログに書くので、ここに残るのは起動の失敗だけ。
    ログのディレクトリが無いと launchd が起動に失敗するため、phase_launchd が先に作る
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.thanks2music.brew-update-check</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/bin/brew-update-check</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>12</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>WorkingDirectory</key>
	<string>__HOME__</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/brew-update-check/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/brew-update-check/launchd.log</string>
</dict>
</plist>
