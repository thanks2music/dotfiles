# ===== Claude Code 設定 =====

# 出力トークン制限（大規模ドキュメント生成用）
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=64000

# ファイル読み取りトークン制限（オプション）
export CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS=100000

# tmux の中でも Claude Code を 24-bit カラーで描く。dot.tmux.conf の Tc とセット（説明と出典はそちら）
export CLAUDE_CODE_TMUX_TRUECOLOR=1

# その他の便利な設定（オプション）
# export CLAUDE_CODE_SHELL=/bin/zsh
# export CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=true
